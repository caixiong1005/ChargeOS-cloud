            </dependency>

            <!-- Mybatis 依赖配置 -->
<!--            <dependency>-->
<!--                <groupId>org.mybatis.spring.boot</groupId>-->
<!--                <artifactId>mybatis-spring-boot-starter</artifactId>-->
<!--                <version>${spring-boot.mybatis}</version>-->
<!--            </dependency>-->

            <!-- 修复 mybatis-spring 2.1.2 与 Spring Framework 6.1.5 不兼容:
