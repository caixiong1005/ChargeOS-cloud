        <spring-boot.mybatis.plus>3.5.7</spring-boot.mybatis.plus>
        <springdoc.version>2.5.0</springdoc.version>
        <swagger.annotations.version>2.2.20</swagger.annotations.version>
        <jasypt.version>3.0.5</jasypt.version>
        <micrometer.tracing.version>1.2.4</micrometer.tracing.version>
        <zipkin.reporter.version>3.5.0</zipkin.reporter.version>
        <tobato.version>1.27.2</tobato.version>
        <hutool.version>5.8.31</hutool.version>
        <kaptcha.version>2.3.3</kaptcha.version>
        <pagehelper.boot.version>1.4.7</pagehelper.boot.version>
        <alibaba.seata.version>2.0.0</alibaba.seata.version>
