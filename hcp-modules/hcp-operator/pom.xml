<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zkhz</groupId>
        <artifactId>hcp-modules</artifactId>
        <version>1.2.2</version>
    </parent>

    <artifactId>hcp-operator</artifactId>

    <description>
        hcp-operator 运营端模块
    </description>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>

        <!-- SpringCloud Alibaba Nacos -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- SpringCloud Alibaba Nacos Config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- SpringCloud Alibaba Sentinel -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
            <exclusions>
                <!-- operator 是 servlet(Tomcat) 应用：sentinel 的 webflux-adapter 会拉入
                     spring-boot-starter-undertow 及其 JSR-356 WebSocket 实现，和
                     tomcat-embed-websocket 冲突，导致 Tomcat 的 WsSci 无法注册
                     jakarta.websocket.server.ServerContainer，ServerEndpointExporter
                     启动即抛 "ServerContainer not available"。servlet 应用用不到 webflux 适配器，排除之。 -->
                <exclusion>
                    <groupId>com.alibaba.csp</groupId>
                    <artifactId>sentinel-spring-webflux-adapter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SpringBoot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger UI -->
<!--        <dependency>-->
<!--            <groupId>org.springdoc</groupId>-->
<!--            <artifactId>springdoc-openapi-ui</artifactId>-->
<!--            <version>${springdoc.version}</version>-->
<!--        </dependency>-->

        <!-- Mysql Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- hcp Common DataSource -->
        <dependency>
            <groupId>com.zkhz</groupId>
            <artifactId>hcp-common-datasource</artifactId>
            <exclusions>
                <!-- dynamic-datasource-spring-boot3-starter 会传递拉入 spring-boot-starter-undertow
                     及其 JSR-356 WebSocket 实现，与 operator 的 servlet(Tomcat) 容器冲突，
                     导致 Tomcat 的 WsSci 无法注册 jakarta.websocket.server.ServerContainer，
                     ServerEndpointExporter 启动即抛 "ServerContainer not available"。operator 是
                     servlet 应用、用 Tomcat 的 websocket，故排除 undertow。 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-undertow</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- hcp Common DataScope -->
        <dependency>
            <groupId>com.zkhz</groupId>
            <artifactId>hcp-common-datascope</artifactId>
        </dependency>

        <!-- hcp Common Log -->
        <dependency>
            <groupId>com.zkhz</groupId>
            <artifactId>hcp-common-log</artifactId>
        </dependency>

        <!-- hcp Common Swagger -->
<!--        <dependency>-->
<!--            <groupId>com.zkhz</groupId>-->
<!--            <artifactId>hcp-common-swagger</artifactId>-->
<!--        </dependency>-->

        <!-- hcp Common tenant -->
        <dependency>
            <groupId>com.zkhz</groupId>
            <artifactId>hcp-common-mybatisplus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>