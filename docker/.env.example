# =============================================================================
# ChargeOS 部署环境变量样例（集中管理密钥，单一来源）
# 用法：
#   1) 复制为 .env：  cp .env.example .env
#   2) 把下方占位值替换为真实随机强口令/密钥
#      —— 注意：compose 文件已不再内置任何口令默认值；未设置 .env 时容器将因缺少
#         必需的环境变量而无法启动。这正是“密钥外部化”的目的（避免明文口令入库）。
#   3) 在 docker/ 目录下执行：docker compose -f docker-compose.yml up -d
#                          或  docker compose -f docker-compose-infra.yml up -d
# 说明：compose 中以 ${VAR} 引用的变量，会从同目录的 .env 文件（或 shell 环境）读取。
#       本文件即这些变量的“单一来源”，便于统一维护与密钥轮换。
#       真实 .env 已被 .gitignore 忽略，切勿提交。
# =============================================================================

# ----------------------------------------------------------------- MySQL ----
# 强口令：MySQL root 密码，同时被 Nacos 持久化连接复用（MYSQL_SERVICE_PASSWORD）
# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=请替换为随机强口令

# ----------------------------------------------------------------- Redis ----
# 强口令：Redis requirepass
# 生成：openssl rand -base64 24
REDIS_PASSWORD=请替换为随机强口令

# ----------------------------------------------------------------- Nacos ----
# 鉴权开关（默认开）
NACOS_AUTH_ENABLE=true
# 鉴权 token 密钥：必须是 base64 且长度 >= 32 字节；
# 生成：openssl rand -base64 32    （生产必须替换为随机值）
NACOS_AUTH_TOKEN=请替换为 openssl rand -base64 32 的输出
# 服务端身份标识（集群节点间校验用；standalone 也可自定义）
NACOS_AUTH_IDENTITY_KEY=hcp-register
NACOS_AUTH_IDENTITY_VALUE=hcp-register-secret

# ----------------------------------------------------- Nacos 控制台账号 ----
# 应用侧连接 Nacos 用的账号/口令（对应 bootstrap.yml 的 ${NACOS_USERNAME}/${NACOS_PASSWORD}）
# 与 Nacos 控制台创建的账号一致；默认 nacos/nacos 仅用于本地开发
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# -------------------------------------------------------------- 应用侧 ----
# JWT 签名密钥（网关/认证服务使用，必须随机且保密）
# 生成：openssl rand -base64 32
JWT_SECRET=请替换为 openssl rand -base64 32 的输出
# 部署机内网 IP（用于服务注册 NETWORK_IP；容器编排内通常为服务名，可保留默认）
DEPLOY_IP=192.168.1.4
